# Salin file ini menjadi ".env" dan sesuaikan nilainya.

# Database: Supabase project "ArtaMotor" (ref: ugxhbuwgafzdtmhnjguh)
# Ambil password database di Supabase Dashboard > Project Settings > Database.
# DATABASE_URL = koneksi pooled (PgBouncer, port 6543) — dipakai runtime app.
# DIRECT_URL   = koneksi langsung (port 5432) — dipakai Prisma saat migrate.
DATABASE_URL="postgresql://postgres.ugxhbuwgafzdtmhnjguh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.ugxhbuwgafzdtmhnjguh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

PORT=4000
NODE_ENV=development

# Secret untuk JSON Web Token (fitur autentikasi, langkah berikutnya)
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"
JWT_EXPIRES_IN="8h"
